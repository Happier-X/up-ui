{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./packages/*"],
      "@hakimi-ui/utils": ["./packages/utils/index.ts"],
      "@hakimi-ui/hook": ["./packages/hook/index.ts"],
      "@hakimi-ui/components": ["./packages/components/index.ts"]
    }
  },
  "include": ["packages/**/*", "packages/**/*.vue"],
  "exclude": ["node_modules", "dist", "examples", "docs"]
}
